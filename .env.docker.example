# Docker Environment Variables Example
# Copy this file to .env.docker and update values as needed

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/food_delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_delivery

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Consul
CONSUL_HOST=consul
CONSUL_PORT=8500

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
RESTAURANT_SERVICE_PORT=3003
MENU_SERVICE_PORT=3004
ORDER_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
DELIVERY_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008

# Node Environment
NODE_ENV=development
